Hover fix for marked terms covered by KaTeX layout elements (radical SVG,
depth rows and row wrappers of vertical lists). Combined diff of the
hover-fix branch of https://github.com/rolandmueller/equations-explained-colorfully
(PR: https://github.com/stared/equations-explained-colorfully/pull/4),
applied on top of upstream 19acd52 by `just install`.

diff --git a/src/components/equation/EquationDisplay.vue b/src/components/equation/EquationDisplay.vue
index e0b5a16..733fcc8 100644
--- a/src/components/equation/EquationDisplay.vue
+++ b/src/components/equation/EquationDisplay.vue
@@ -189,6 +189,21 @@ onUnmounted(() => resizeObserver?.disconnect());
   margin: 0;
 }
 
+/* KaTeX overlays that would swallow hovers on marked terms:
+   the radical is a 400em-wide SVG drawn over the radicand, the empty
+   depth row of a vertical list (fractions, sums, aligned) covers the
+   lower half, and each row of a vertical list sits in a wrapper whose
+   tall invisible strut can reach over the content above it */
+#equation-container :deep(.hide-tail),
+#equation-container :deep(.vlist-t2 > .vlist-r:last-child),
+#equation-container :deep(.vlist > span) {
+  pointer-events: none;
+}
+
+#equation-container :deep(.vlist > span > :not(.pstrut):not(.hide-tail)) {
+  pointer-events: auto;
+}
+
 .selection-overlay {
   position: absolute;
   top: 0;
